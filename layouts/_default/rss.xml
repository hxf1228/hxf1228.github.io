{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>Recent content on {{ site.Title }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale }}</language>
    {{ with .OutputFormats.Get "rss" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />{{ end }}
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{ $pages := .Pages }}
    {{ if .IsHome }}{{ $pages = site.RegularPages }}{{ end }}
    {{ range first 20 $pages.ByDate.Reverse }}
    {{- $desc := "" -}}
    {{- with .Params.summary }}{{ $desc = . }}{{ end -}}
    {{- if not $desc }}{{ with .Params.abstract }}{{ $desc = . | truncate 280 }}{{ end }}{{ end -}}
    {{- if not $desc }}{{ $desc = .Summary | plainify | truncate 280 }}{{ end }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ $desc | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{ end }}
  </channel>
</rss>